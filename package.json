{
  "name": "yantr",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "podman": "podman stop yantr || true && podman rm yantr || true && sleep 2 && podman build -t yantr:dev . && podman run -d --name yantr --network host --security-opt label=disable -v ${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock:/run/podman/podman.sock -v yantr_data:/data:z yantr:dev",
    "website": "node scripts/website-build.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@lucide/vue": "latest",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@tailwindcss/vite": "^4.1.3",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.1.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "nunjucks": "^3.2.4",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2"
  }
}

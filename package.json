{
  "name": "yantr",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "docker": "docker stop yantr || true && docker rm yantr || true && sleep 2 && docker build -t yantr:dev . && docker run --name yantr --network host -v /var/run/docker.sock:/var/run/docker.sock -v /var/lib/docker/volumes:/var/lib/docker/volumes yantr:dev",
    "core:build": "cd core && CGO_ENABLED=0 go build -ldflags='-w -s' -o ../yantr-core . && cd ..",
    "core:run": "YANTR_SERVE_UI=true YANTR_APPS_DIR=./apps ./yantr-core",
    "website": "npx @tailwindcss/cli -i ./website/tailwind.input.css -o ./website/tailwind.css --minify && node website-build.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@tailwindcss/vite": "^4.1.3",
    "dockerode": "^4.0.9",
    "fastify": "^5.3.2",
    "lucide-vue-next": "^0.487.0",
    "tailwindcss": "^4.1.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@vitejs/plugin-vue": "^5.2.3",
    "nunjucks": "^3.2.4",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2"
  }
}

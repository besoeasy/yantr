{
  "name": "yantr",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "docker": "docker stop yantr || true && docker rm yantr || true && sleep 2 && docker build -t yantr:dev . && docker run --name yantr --network host -v /var/run/docker.sock:/var/run/docker.sock -v /var/lib/docker/volumes:/var/lib/docker/volumes yantr:dev",
    "website": "npx @tailwindcss/cli -i ./website/tailwind.input.css -o ./website/tailwind.css --minify && node scripts/website-build.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@lucide/vue": "latest",
    "tailwindcss": "^4.1.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@vitejs/plugin-vue": "^5.2.3",
    "nunjucks": "^3.2.4",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2"
  }
}

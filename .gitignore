# Dependencies & build outputs
node_modules
dist
.vite

# Environment files
.env
.env.local
.env.*.local
apps/*/.env

# App compose temp & override files
apps/*/compose.temp.yml
apps/*/.compose.temp.yml
apps/*/.compose.tmp.yml
apps/*/compose.override.yml

# Per-project files generated at deploy time by core/compose
#   .compose.<project>.yml  rendered compose stack
#   .env.<project>          resolved deploy env (may hold secrets)
apps/*/.compose.*.yml
apps/*/.env.*

# Website generated assets
website/tailwind.css
website/apps.json
website/apps
website/developer
website/github-data.json
website/install.sh
website/catalog

# Binaries & test artifacts
yantr
core/yantr
*.test
coverage.out

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs

# OS & Editor files
.DS_Store
Thumbs.db
.idea
.vscode

# Agent session artifacts (screenshots and scratch files written by coding agents)
.openchamber

# Go toolchain caches (created when building via the golang container)
core/.cache/
core/.config/

# Temp files
tmp
check_output*.txt
*.txtn
.npm-cache
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="keywords" content="{{ app.name }}, self-host {{ app.name }}, install {{ app.name }} podman, {{ app.name }} homelab, {{ app.name }} self-hosted, podman compose {{ app.name }}{% if app.tags.length %}, {{ app.tags | join(', ') }}{% endif %}, yantr, self-hosted apps" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href="{{ pageUrl }}" />
    <meta name="robots" content="index,follow,max-image-preview:large" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "{{ app.name }}",
      "description": "{{ app.description }}",
      "url": "{{ pageUrl }}",
      "image": "{{ imageUrl }}",
      "applicationCategory": "{% if app.tags.length %}{{ app.tags[0] | title }}{% else %}Utilities{% endif %}",
      "keywords": "{% if app.tags.length %}{{ app.tags | join(', ') }}{% endif %}",
      "operatingSystem": "Linux, Podman",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }{% if app.website %},
      "sameAs": "{{ app.website }}"{% endif %}{% if app.usecases.length %},
      "featureList": [{% for uc in app.usecases %}"{{ uc }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Yantr",
          "item": "https://yantr.org/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{ app.name }}",
          "item": "{{ pageUrl }}"
        }
      ]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "{{ pageTitle }}",
      "description": "{{ pageDescription }}",
      "url": "{{ pageUrl }}",
      "about": {
        "@type": "Thing",
        "name": "{{ app.name }}"
      },
      "isPartOf": {
        "@type": "WebSite",
        "name": "Yantr",
        "url": "https://yantr.org/"
      }
    }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/yantr.png" />

    <meta property="og:type" content="article" />
    <meta property="og:url" content="{{ pageUrl }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:image" content="{{ imageUrl }}" />
    <meta property="og:image:alt" content="{{ app.name }} logo" />
    <meta property="og:site_name" content="Yantr" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="{{ pageUrl }}" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDescription }}" />
    <meta name="twitter:image" content="{{ imageUrl }}" />

    <!-- Vanilla CSS (no Tailwind) -->
    <link rel="stylesheet" href="../../style.css" />
  </head>

  <body>
    <main class="page-narrow">

      <!-- Breadcrumb -->
      <a href="../../#all-apps" class="crumb">
        <svg  fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        All apps
      </a>

      <!-- Hero -->
      <div class="app-hero">
        <img src="{{ app.logoUrl }}" alt="{{ app.name }} logo"  loading="eager" />
        <div>
          <p class="kicker">Self-host with Podman · Yantr</p>
          <h1>{{ app.name }}</h1>
          {% if app.short_description %}
            <p class="short">{{ app.short_description }}</p>
          {% endif %}
          {% if app.tags.length %}
            <div class="app-tags">
              {% for tag in app.tags %}
                <span>{{ tag }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Stats row -->
      <div class="app-stats">
        <div>
          <p class="num">{{ app.ports.length }}</p>
          <p class="lbl">Ports</p>
        </div>
        <div class="vsep"></div>
        <div>
          <p class="num">{{ app.notes.length }}</p>
          <p class="lbl">Notes</p>
        </div>
        <div class="vsep"></div>
        <div>
          <p class="num">{{ app.usecases.length }}</p>
          <p class="lbl">Use Cases</p>
        </div>
      </div>

      <!-- CTAs -->
      <div class="app-ctas">
        {% if app.website %}
          <a href="{{ app.website }}" target="_blank" rel="noopener noreferrer"
            class="btn btn-dark">
            <svg  fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            Official Website
          </a>
        {% endif %}
        <a href="{{ app.sourceAppFolderUrl }}" target="_blank" rel="noopener noreferrer"
          class="btn btn-light">
          <svg  fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          View on GitHub
        </a>
      </div>

      <!-- About -->
      {% if app.description %}
        <section class="doc-section">
          <p class="kicker">About</p>
          <h2>What {{ app.name }} does</h2>
          <p>{{ app.description }}</p>
        </section>
      {% endif %}

      <!-- Install Flow -->
      <section class="doc-section">
        <p class="kicker">Install Flow</p>
        <h2>How to self-host {{ app.name }}</h2>
        <div>
          <p>{{ app.name }} can be deployed with standard compose files using the Yantr app catalog. This page collects the basic information searchers usually need first: what {{ app.name }} does, which container image Yantr uses, default ports, deployment notes, and where to find the original compose template.</p>
          <p>After deployment, Yantr lets you publish additional ports from the stack page using standard port syntax. Use <span class="mono">8080:8080</span> for a fixed host port or just <span class="mono">8080</span> to let Podman assign an automatic port.</p>
        </div>
      </section>

      <!-- Use Cases -->
      {% if app.usecases.length %}
        <section class="doc-section">
          <p class="kicker">Use Cases</p>
          <h2>What people run it for</h2>
          <ul class="usecase-list">
            {% for uc in app.usecases %}
              <li>
                <svg  fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                {{ uc }}
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      <!-- Technical Details -->
      <section class="doc-section">
        <p class="kicker">Technical Details</p>
        <h2>Ports, image, and service metadata</h2>

        {% if app.ports.length %}
          <div>
            <p class="ports-label">Ports</p>
            <div class="ports-wrap">
              <table class="ports-table">
                <thead>
                  <tr>
                    <th>Port</th>
                    <th>Protocol</th>
                    <th>Label</th>
                  </tr>
                </thead>
                <tbody>
                  {% for p in app.ports %}
                    <tr>
                      <td class="port">{{ p.port }}</td>
                      <td>
                        <span class="proto">{{ p.protocol }}</span>
                      </td>
                      <td>{{ p.label }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        {% endif %}

        <div class="meta-grid">
          {% if app.image %}
            <div>
              <p class="meta-label">Container Image</p>
              <p class="meta-val">{{ app.image }}</p>
            </div>
          {% endif %}
          {% if app.serviceName %}
            <div>
              <p class="meta-label">Service Name</p>
              <p class="meta-val">{{ app.serviceName }}</p>
            </div>
          {% endif %}
        </div>
      </section>

      <!-- Notes -->
      {% if app.notes and app.notes.length %}
        <section class="doc-section">
          <p class="kicker">Notes</p>
          <h2>Things to know before you deploy</h2>
          <ul class="note-list">
            {% for note in app.notes %}
              <li>
                {{ note }}
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      <!-- Related Apps -->
      {% if relatedApps.length %}
        <section class="doc-section">
          <p class="kicker">Related Apps</p>
          <h2>More tools you might pair with {{ app.name }}</h2>
          <div class="related-grid">
            {% for related in relatedApps %}
              <a href="../{{ related.id }}/" class="related-card">
                <img src="{{ related.logoUrl }}" alt="{{ related.name }}"  loading="lazy" />
                <div>
                  <p class="rel-name">{{ related.name }}</p>
                  <p class="rel-desc">{{ related.short_description or related.description }}</p>
                </div>
              </a>
            {% endfor %}
          </div>
        </section>
      {% endif %}
      <p class="generated">Page generated {{ nowIso }}</p>
    </main>
  </body>
</html>

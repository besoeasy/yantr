<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="keywords" content="{{ developer.key }}, {{ developer.platformLabel }}, self-hosted apps, podman compose, homelab, yantr{% for app in developer.apps %}, {{ app.name }}{% endfor %}" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href="{{ pageUrl }}" />
    <meta name="robots" content="index,follow,max-image-preview:large" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "name": {{ pageTitle | dump | safe }},
      "description": {{ pageDescription | dump | safe }},
      "url": {{ pageUrl | dump | safe }},
      "mainEntity": {
        "@type": "Person",
        "name": {{ developer.key | dump | safe }},
        "identifier": {{ developer.key | dump | safe }},
        "url": {{ pageUrl | dump | safe }},
        "sameAs": {{ developer.url | dump | safe }}
      },
      "hasPart": [
        {% for app in developer.apps %}{
          "@type": "SoftwareApplication",
          "name": {{ app.name | dump | safe }},
          "url": "https://yantr.org{{ app.appPagePath }}",
          "applicationCategory": "{% if app.tags.length %}{{ app.tags[0] | title }}{% else %}Utilities{% endif %}"
        }{% if not loop.last %},{% endif %}{% endfor %}
      ]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Yantr",
          "item": "https://yantr.org/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ developer.key | dump | safe }},
          "item": {{ pageUrl | dump | safe }}
        }
      ]
    }
    </script>

    <meta property="og:type" content="profile" />
    <meta property="og:url" content="{{ pageUrl }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:site_name" content="Yantr" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content="{{ pageUrl }}" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDescription }}" />

    <!-- Vanilla CSS (no Tailwind) -->
    <link rel="stylesheet" href="../../style.css" />
  </head>

  <body>
    <main class="page-narrow">

      <!-- Breadcrumb -->
      <a href="../../#all-apps" class="crumb">
        <svg  fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        All apps
      </a>

      <!-- Hero -->
      <div class="developer-hero">
        <div class="developer-hero-avatar">{{ developer.initials }}</div>
        <div class="app-hero-body">
          <p class="kicker">{{ developer.platformLabel }} developer · Yantr</p>
          <h1>{{ developer.shortKey }}</h1>
          <p class="short">Maintains {{ developer.apps.length }} app{% if developer.apps.length != 1 %}s{% endif %} in the Yantr catalog.</p>
          <!-- The full key, in mono, because the heading is abbreviated and this
               is the thing a reader needs in order to verify it. Deliberately not
               .app-tags: that uppercases, which bech32 forbids. -->
          <p class="developer-ref mono">{{ developer.key }}</p>
        </div>
      </div>

      <!-- Stats row -->
      <div class="app-stats">
        <div>
          <p class="num">{{ developer.apps.length }}</p>
          <p class="lbl">Apps</p>
        </div>
        <div class="vsep"></div>
        <div>
          <p class="num">{{ developer.platformLabel }}</p>
          <p class="lbl">Platform</p>
        </div>
      </div>

      <!-- CTAs -->
      <div class="app-ctas">
        <a href="{{ developer.url }}" target="_blank" rel="noopener noreferrer" class="btn btn-dark">
          <svg  fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Open the Nostr account
        </a>
        <a href="../../#all-apps" class="btn btn-light">
          <svg  fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          Browse the catalog
        </a>
      </div>

      <!-- Apps -->
      <section class="doc-section">
        <p class="kicker">Apps</p>
        <h2>What this account maintains</h2>
        <div>
          <p>Every app below declares <span class="mono">{{ developer.key }}</span> in its catalog entry, so the credit is part of the app definition rather than a separate list that can drift.</p>
        </div>

        <div class="developer-app-list">
          {% for app in developer.apps %}
            <a href="{{ app.appPagePath }}" class="developer-app">
              <img src="{{ app.logoUrl }}" alt="{{ app.name }} logo" loading="lazy" />
              <div>
                <p class="developer-app-name">{{ app.name }}</p>
                <p class="developer-app-desc">{{ app.summary }}</p>
              </div>
              <span class="developer-app-count">{{ app.ports.length }} port{% if app.ports.length != 1 %}s{% endif %}</span>
            </a>
          {% endfor %}
        </div>
      </section>

      <!-- How the credit works -->
      <section class="doc-section">
        <p class="kicker">About</p>
        <h2>How developer credit works</h2>
        <div>
          <p>An app author is declared in the app's compose file as their Nostr public key — an <span class="mono">npub1…</span> or <span class="mono">nprofile1…</span> — under <span class="mono">x-yantr.developers</span>, alongside the app's name, ports and notes. Yantr reads it from the same file it deploys, which is why this page needs no separate account or sign-up.</p>
          <p>Every entry is decoded and checksum-verified when the catalog loads, so an app can only credit a key that is a key. An issue filed from an app page names the key but cannot notify the account: a GitHub issue cannot <span class="mono">@mention</span> a Nostr account, so this is information rather than a ping.</p>
        </div>
      </section>

      <footer class="site-footer">
        <p>Generated {{ nowIso }} · <a href="../../">Yantr</a></p>
      </footer>

    </main>
  </body>
</html>
